#!/usr/bin/bash
# nodi: Nodi from a terminal or a script (docs/extend.md, "From a terminal").
#
#   nodi                      open the bar
#   nodi <words...>           open it with the words typed ("nodi -- run x"
#                             types "run x")
#   nodi run <key>            run a row by its key, as its hotkey would
#   nodi pick [--json] [--placeholder <text>]
#                             rows from stdin, a line each; the one chosen is
#                             printed as it was read
#   nodi mcp                  the bar as an MCP server on stdin and stdout,
#                             for another agent (docs/extend.md, "For agents")
#
# Exit status: 0 done, 1 nothing was chosen (Escape, or the bar closed),
# 2 Nodi refused it (an unknown row, a row that asks first, rows it could
# not read), its function failed, or the command was misused, 3 Nodi could not be reached (the
# shell not running, Nodi not loaded, omarchy-shell or jq missing), 4 a
# newer pick took the bar before this one was answered.
#
# Everything goes through Omarchy's shell IPC (omarchy-shell): summon opens
# the bar with a payload, call runs one of Nodi's functions. A pick's rows go
# by file, as an IPC argument is capped by the kernel's argument limit, in a
# directory of its own under XDG_RUNTIME_DIR that only this user can read;
# the answer comes back through a FIFO there, read while it is asked every
# two seconds whether the pick is still open, so a bar reloaded mid-pick
# ends the wait instead of holding it for ever.
set -u
# Programs from the system's own directories, whatever PATH the caller has;
# omarchy-shell is named by its full path below.
PATH=/usr/bin:/bin
export PATH

id=io.github.itsgg.nodi
# omarchy-shell refuses to run without OMARCHY_PATH, which an agent that
# starts its MCP servers with a cleared environment (Codex) does not pass.
OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
export OMARCHY_PATH
ipc=$OMARCHY_PATH/bin/omarchy-shell
# The user's own runtime folder, for the bar's payloads and a pick's rows.
# Codex clears it too: then logind's /run/user/<uid>, as Qt (and so the
# shell's IPC) takes it; components/Carried.qml reads only under it
# (Fable 2026-10-10: to /tmp, every tool call was "cannot be reached").
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ] && [ -O "/run/user/$(id -u)" ]; then
  XDG_RUNTIME_DIR=/run/user/$(id -u)
  export XDG_RUNTIME_DIR
fi

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }

fail() { echo "nodi: $*" >&2; exit 2; }
# Kept apart from a refusal, so a caller can tell "no" from "not there"
# (a check 2026-10-05).
unreachable() { echo "nodi: $*" >&2; exit 3; }

command -v jq >/dev/null || unreachable "jq is needed"
[ -x "$ipc" ] || unreachable "omarchy-shell not found at $ipc"

# One call to Nodi through the shell: its answer on stdout, or exit 3 when
# omarchy-shell fails (the shell down, or a Nodi too old to have the
# function: "Function not found.") or the shell answers "unknown" (Nodi
# disabled or not loaded).
ask() {
  local out
  out=$("$ipc" shell "$@") || unreachable "the Omarchy shell cannot be reached, or this Nodi is too old for it"
  [ "$out" = unknown ] && unreachable "Nodi is not loaded"
  # What the shell answers when the function threw (Fable 2026-10-06).
  [ "$out" = error ] && fail "Nodi failed to answer; the shell's log says why"
  printf '%s' "$out"
}

open_with() {
  local payload
  payload=$(NODI_Q=$1 jq -cn '{query: $ENV.NODI_Q}') || fail "could not encode the query"
  carry_init
  carry "$payload" || fail "could not hand the bar its query"
  # The bar reads it when Nodi opens, and at the shell's start that waits
  # for Nodi to load (shell.qml queues the payload): the folder goes a
  # minute later, not at exit (Fable 2026-10-10: the bar opened empty).
  trap - EXIT
  ( sleep "${NODI_CARRY_KEEP:-60}"; rm -rf -- "$carry_dir" ) >/dev/null 2>&1 &
  out=$(ask summon "$id" "$CARRIED") || exit $?
  [ "$out" = ok ] || fail "Nodi did not open ($out)"
}

pick() {
  local json=false placeholder="" dir rid req out reply n
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=true ;;
      -p|--placeholder) [ $# -ge 2 ] || fail "--placeholder needs a text"; placeholder=$2; shift ;;
      *) fail "pick: unknown option $1" ;;
    esac
    shift
  done
  runtime=${XDG_RUNTIME_DIR:-/tmp}
  # The payload's folder first, so its trap holds if the next mktemp fails.
  carry_init
  dir=$(mktemp -d "${runtime%/}/nodi-pick.XXXXXXXX") || fail "no directory for the rows"
  rid=${dir##*.}
  trap 'rm -rf -- "$dir" "$carry_dir"' EXIT
  # Ended from outside (`nodi mcp`'s client went away, Ctrl-C under a slow
  # producer): the directory goes, and the bar is told, so no question
  # waits there for nobody (Fable 2026-10-06: set this late, a signal
  # while the rows were read left the directory).
  trap '"$ipc" shell call "$id" cancelPick "$rid" >/dev/null 2>&1; exit 1' TERM INT HUP
  # At most what the bar reads (8 MB, PickSession.qml), counted as it is
  # written: past it the pick is refused before anything is kept (codex's
  # review, 2026-10-09: the rows went whole into the runtime directory,
  # memory, however many came).
  head -c 8388609 > "$dir/rows" || fail "could not read stdin"
  [ "$(stat -c %s -- "$dir/rows")" -le 8388608 ] || fail "more than 8 MB of rows"
  mkfifo -m 600 "$dir/answer" || fail "no FIFO for the answer"
  # Read and write: opening it so never waits for a writer, and Nodi's
  # write never waits for this reader.
  exec 3<>"$dir/answer"
  req=$(NODI_P=$placeholder jq -cn --arg dir "$dir" --arg id "$rid" --argjson json "$json" \
    '{dir: $dir, id: $id, placeholder: $ENV.NODI_P, json: $json}') || fail "could not encode the request"
  carry "$req" || fail "could not hand the bar the pick"
  out=$(ask call "$id" pick "$CARRIED") || exit $?
  [ "$out" = ok ] || fail "Nodi refused the pick ($out)"
  reply=""
  while ! IFS= read -r -t 2 reply <&3; do
    out=$("$ipc" shell call "$id" pickAlive "$rid" 2>/dev/null)
    [ "$out" = yes ] && continue
    # Closed between the read and the question: its answer may be on its
    # way, a fork and an exec behind the close (Fable 2026-10-05).
    IFS= read -r -t 1 reply <&3 || exit 1
    break
  done
  case $reply in
    "pick "*)
      n=${reply#pick }
      [[ $n =~ ^[0-9]+$ ]] || fail "a bad answer from Nodi"
      sed -n "$((n + 1))p" "$dir/rows"
      exit 0 ;;
    error) fail "Nodi could not read the rows (more than 8 MB, or gone)" ;;
    replaced) exit 4 ;;
    *) exit 1 ;;
  esac
}

# ---------------------------------------------------------------- nodi mcp

# The bar as an MCP server (ROADMAP 45, 46): JSON-RPC 2.0, a message a
# line on stdin and stdout, MCP's stdio transport. Its tools: search the
# bar's rows, run one (refusing a row that asks, as `nodi run` does),
# propose one (the bar opens on it; his Enter runs it, Escape refuses), and
# approve, a permission prompt tool for `claude -p --permission-prompt-tool
# mcp__nodi__approve`: the bar shows the tool and its input, his Enter
# allows it. A call that cannot reach the bar is a tool error, never the
# end of the server.

MCP_TOOLS='[
 {"name": "search", "description": "Search the Omarchy command bar (Nodi) for rows: apps, open windows, settings and toggles, Omarchy menu actions and commands, keybindings, snippets, files and the rest of what the bar holds. Returns up to 8 rows, best first, each with a key to run or propose it by, what it runs, and whether it asks before running.",
  "inputSchema": {"type": "object", "properties": {"query": {"type": "string", "description": "What a person would type in the bar"}}, "required": ["query"]},
  "annotations": {"readOnlyHint": true}},
 {"name": "run", "description": "Run a row by its key, from search, at once. A row that asks before it runs is refused: propose it instead.",
  "inputSchema": {"type": "object", "properties": {"key": {"type": "string"}}, "required": ["key"]},
  "annotations": {"readOnlyHint": false}},
 {"name": "propose", "description": "Show a row, by its key from search, in the bar on the person'"'"'s screen: Enter runs it, Escape refuses. Waits for the answer.",
  "inputSchema": {"type": "object", "properties": {"key": {"type": "string"}}, "required": ["key"]},
  "annotations": {"readOnlyHint": false}},
 {"name": "approve", "description": "A permission prompt tool for claude -p (--permission-prompt-tool mcp__nodi__approve): shows the tool and its input in the bar; Enter allows it, Escape refuses.",
  "inputSchema": {"type": "object", "properties": {"tool_name": {"type": "string"}, "input": {"type": "object"}, "tool_use_id": {"type": "string"}}, "required": ["tool_name", "input"]},
  "annotations": {"readOnlyHint": true}}
]'

MCP_VERSIONS=" 2024-11-05 2025-03-26 2025-06-18 2025-11-25 "
MCP_PICK=""

mcp_result() { jq -cn --argjson id "$1" --argjson r "$2" '{jsonrpc: "2.0", id: $id, result: $r}'; }
mcp_error() { jq -cn --argjson id "$1" --argjson c "$2" --arg m "$3" '{jsonrpc: "2.0", id: $id, error: {code: $c, message: $m}}'; }
# A tool's answer: its text, and whether it is an error. The text goes in
# on stdin: an approve's input can pass the 128 KB one argument may hold
# (Fable 2026-10-06: the reply was lost, after he had allowed it).
mcp_text() {
  printf '%s' "$2" | jq -cRs --argjson id "$1" --argjson e "${3:-false}" \
    '{jsonrpc: "2.0", id: $id, result: {content: [{type: "text", text: .}], isError: $e}}'
}

# One row in the bar, chosen with Enter or not: exit 0 chosen, 1 not, 4 a
# newer pick took the bar, 2 or 3 it refused or could not be reached. In
# the background, so a signal ending the server ends the pick too.
# Why a call to the bar failed, by ask's exit: 2 its function failed, 3 or
# else it could not be reached (Fable 2026-10-06).
mcp_why() { if [ "$1" -eq 2 ]; then echo "Nodi failed to answer; the shell's log says why"; else echo "The bar cannot be reached"; fi; }

# What goes to the bar through a file, never an IPC argument, which
# another local user can read in /proc while the call runs (the
# marketplace's review of f444138, 2026-10-10): an agent's searches and
# messages, a row's key. One folder a server, 0700 by mktemp -d, gone when
# it ends; components/Carried.qml reads "@file:<folder>/payload" and
# nothing else. The text goes in by printf, a builtin, so it is in no
# argument either.
carry_dir=""
carry_init() {
  local runtime=${XDG_RUNTIME_DIR:-/tmp}
  carry_dir=$(mktemp -d "${runtime%/}/nodi-ipc.XXXXXXXXXX") || fail "no private directory for the bar's calls"
  trap 'rm -rf -- "$carry_dir"' EXIT
}
# carry TEXT: TEXT in the folder, and CARRIED the argument that names it.
CARRIED=""
carry() {
  ( umask 077; printf '%s' "$1" > "$carry_dir/payload.part" ) && mv -f -- "$carry_dir/payload.part" "$carry_dir/payload" || return 1
  CARRIED="@file:$carry_dir/payload"
}

mcp_ask() {
  local s
  printf '%s\n' "$2" | "$0" pick --json --placeholder "$1" >/dev/null 2>&1 &
  MCP_PICK=$!
  wait "$MCP_PICK"; s=$?
  MCP_PICK=""
  return $s
}

mcp_call() {
  local mid=$1 msg=$2 name key q out info row s
  # Params of any shape: what is not an object names nothing.
  name=$(jq -r '((try .params.name catch null) // "") | tostring' <<<"$msg")
  # A query or a key the bar reads whole: past 64 KB it is refused here.
  q=$(jq -r '((try .params.arguments.query catch null) // "") | tostring' <<<"$msg")
  key=$(jq -r '((try .params.arguments.key catch null) // "") | tostring' <<<"$msg")
  # Bytes, not characters: 60000 Tamil letters are 180000 bytes (Fable 2026-10-06).
  if [ "$(LC_ALL=C; echo $(( ${#q} > ${#key} ? ${#q} : ${#key} )))" -gt 65536 ]; then
    mcp_text "$mid" "Too long: a query or a key is 64 KB at most" true; return
  fi
  jq -e '(try .params.arguments catch "bad") | . == null or type == "object"' >/dev/null <<<"$msg" \
    || { mcp_error "$mid" -32602 "arguments must be an object"; return; }
  case $name in
    search)
      carry "$q" || { mcp_text "$mid" "$(mcp_why 3)" true; return; }
      out=$(ask call "$id" search "$CARRIED") || { mcp_text "$mid" "$(mcp_why $?)" true; return; }
      mcp_text "$mid" "$out" ;;
    run)
      carry "$key" || { mcp_text "$mid" "$(mcp_why 3)" true; return; }
      out=$(ask call "$id" runFound "$CARRIED") || { mcp_text "$mid" "$(mcp_why $?)" true; return; }
      if [ "$out" = ok ]; then mcp_text "$mid" "Ran $key"; else mcp_text "$mid" "Not run: $out" true; fi ;;
    propose)
      carry "$key" || { mcp_text "$mid" "$(mcp_why 3)" true; return; }
      info=$(ask call "$id" describeRow "$CARRIED") || { mcp_text "$mid" "$(mcp_why $?)" true; return; }
      jq -e . >/dev/null 2>&1 <<<"$info" || { mcp_text "$mid" "Not run: $info" true; return; }
      # A row that asks for a typed word is never run for an agent: say so
      # before his Enter, which could not be honoured (Fable 2026-10-06).
      if [ "$(jq -r '.asks' <<<"$info")" = "a typed word" ]; then
        mcp_text "$mid" "Not run: it asks for a typed word; open it in the bar" true; return
      fi
      row=$(jq -c '{title: ("Run " + (.title | gsub("[[:cntrl:]]"; " "))), subtitle: (.command | gsub("\\s*\\n+\\s*"; " ")),
                    preview: {title: (.title | gsub("[[:cntrl:]]"; " ")), subtitle: (if .risk != "" then .risk else .subtitle end), markdown: ("```\n" + .command + "\n```")}}' <<<"$info")
      mcp_ask "An agent asks to run this: Enter runs it, Escape refuses" "$row"; s=$?
      if [ $s -eq 0 ]; then
        carry "$key" || { mcp_text "$mid" "$(mcp_why 3)" true; return; }
        out=$(ask call "$id" runProposed "$CARRIED") || { mcp_text "$mid" "$(mcp_why $?)" true; return; }
        if [ "$out" = ok ]; then mcp_text "$mid" "He ran it"; else mcp_text "$mid" "Not run: $out" true; fi
      elif [ $s -eq 1 ]; then mcp_text "$mid" "He refused it"
      elif [ $s -eq 4 ]; then mcp_text "$mid" "Not asked: another question took the bar first" true
      else mcp_text "$mid" "The bar could not ask him" true; fi ;;
    approve)
      row=$(jq -c '.params.arguments as $a | ($a.input // {}) as $i
        | {title: ("Allow " + ($a.tool_name // "a tool" | tostring | gsub("[[:cntrl:]]"; " "))),
           subtitle: (($i.command // $i.file_path // $i.url // $i.query // ($i | tojson)) | tostring
                      | gsub("\\s*\\n+\\s*"; " ") | gsub("[[:cntrl:]]"; " ") | .[0:300]),
           preview: {title: ($a.tool_name // "" | tostring | gsub("[[:cntrl:]]"; " ")), subtitle: "An agent asks to use it",
                     markdown: ("```json\n" + ($i | tojson) + "\n```")}}' <<<"$msg")
      mcp_ask "An agent asks to use a tool: Enter allows it, Escape refuses" "$row"; s=$?
      if [ $s -eq 0 ]; then
        mcp_text "$mid" "$(jq -c '{behavior: "allow", updatedInput: (.params.arguments.input // {})}' <<<"$msg")"
      else
        case $s in
          1) out="He refused it in the bar." ;;
          4) out="Another question took the bar first; he was not asked." ;;
          *) out="The bar could not ask him." ;;
        esac
        mcp_text "$mid" "$(jq -cn --arg m "$out" '{behavior: "deny", message: $m}')"
      fi ;;
    *) mcp_error "$mid" -32602 "no tool $name" ;;
  esac
}

# One line of stdin into `line`, read at most $1 characters at a time, so
# no message is held whole past its cap (codex's review, 2026-10-09: a line
# was read whole before any check). 0 a line, 1 the end of input, 3 a line
# longer than $1 - 1, read to its end and dropped. A last line without its
# newline is still a line.
read_line() {
  local max=$1 rest
  line=""
  if ! IFS= read -r -n "$max" line; then [ -n "$line" ] || return 1; fi
  [ "${#line}" -lt "$max" ] && return 0
  while IFS= read -r -n 65536 rest; do [ "${#rest}" -lt 65536 ] && break; done
  line=""
  return 3
}

mcp() {
  local line kind method mid version asked s
  version=$(jq -r '.version // "0"' "$(dirname -- "$(readlink -f -- "$0")")/../manifest.json" 2>/dev/null) || version=0
  # The client gone (its transport ends the server): a pick it left in the
  # bar goes too (Fable 2026-10-06).
  trap '[ -n "$MCP_PICK" ] && kill -TERM "$MCP_PICK" 2>/dev/null; exit 0' TERM INT HUP
  carry_init
  # A message is 16 MB at most (an approve's input, a file written whole,
  # can be large), a query or a key in it 64 KB (mcp_call).
  while :; do
    read_line 16777217; s=$?
    [ $s -eq 1 ] && break
    [ $s -eq 3 ] && { mcp_error null -32600 "Too long: a message is 16 MB at most"; continue; }
    [ -n "${line//[[:space:]]/}" ] || continue
    # "request", "note" (no id: answered by nothing) or "bad" (a batch, a
    # string), and the method; JSON that does not parse is -32700.
    if ! kind=$(jq -r 'if type != "object" then "bad" elif has("id") then "request" else "note" end' <<<"$line" 2>/dev/null); then
      mcp_error null -32700 "parse error"; continue
    fi
    [ "$kind" = bad ] && { mcp_error null -32600 "not a request object"; continue; }
    method=$(jq -r '.method // "" | tostring' <<<"$line")
    mid=$(jq -c 'if has("id") then .id else null end' <<<"$line")
    if [ "$kind" = note ]; then continue; fi
    [ -n "$method" ] || { mcp_error "$mid" -32600 "no method"; continue; }
    case $method in
      initialize)
        # The client's version when it is one this server speaks, else the newest.
        asked=$(jq -r '.params.protocolVersion // "" | tostring' <<<"$line")
        case $MCP_VERSIONS in *" $asked "*) ;; *) asked=2025-11-25 ;; esac
        mcp_result "$mid" "$(jq -cn --arg v "$version" --arg p "$asked" '{protocolVersion: $p,
          capabilities: {tools: {}}, serverInfo: {name: "nodi", version: $v}}')" ;;
      ping) mcp_result "$mid" '{}' ;;
      tools/list) mcp_result "$mid" "$(jq -c '{tools: .}' <<<"$MCP_TOOLS")" ;;
      tools/call) mcp_call "$mid" "$line" ;;
      # server/discover (MCP 2026-07-28) among them: the client falls back
      # to initialize, as Claude Code 2.1.289 does (probed 2026-10-06).
      *) mcp_error "$mid" -32601 "no method $method" ;;
    esac
  done
}

# ---------------------------------------------------------------- nodi mcp --ask

# Ask's own two tools (ROADMAP 84): the agent Ask holds starts this as its
# stdio MCP server, and each message goes to the shell whole, where Ask
# answers it (lib/AskTools.js mcp), so the tools and what may run are
# defined once. NODI_ASK_SESSION names the session it serves: a server an
# ended session left reaches nothing. A message the shell cannot take is
# answered here, never left waiting.
ASK_RELAY_OUT=""
ASK_RELAY_WHY=""
ASK_RELAY_CODE=-32603
ASK_RELAY_TICKET=""
ASK_RELAY_BUSY=0
ASK_RELAY_STOP=0
ASK_RELAY_ID=""
ASK_RELAY_REQUEST=""
ASK_RELAY_DUPLICATES=0
ASK_RELAY_DUPLICATE_LIMIT=16
ASK_RELAY_INPUT_STATUS=""
ASK_RELAY_READER_FD=""
ASK_RELAY_READER_PID=""
ASK_RELAY_READER_WRITE=""
ASK_RELAY_CANCEL_HOOKED=0

# One short shell IPC call. Its payload has the same bound and shell facade
# error mapping whether it starts a request or polls one.
ask_relay_call() {
  local req=$1
  ASK_RELAY_OUT=""
  ASK_RELAY_CODE=-32603
  if [ -z "$req" ] || [ "$(LC_ALL=C; echo ${#req})" -gt 65536 ]; then
    ASK_RELAY_WHY="Too long: a message is 64 KB at most"
    ASK_RELAY_CODE=-32602
    return 1
  fi
  if carry "$req" && ASK_RELAY_OUT=$("$ipc" shell call "$id" askMcp "$CARRIED" 2>/dev/null); then
    case $ASK_RELAY_OUT in
      ""|ok) ASK_RELAY_WHY="The bar gave no answer"; return 1 ;;
      error) ASK_RELAY_WHY="Nodi failed to answer; the shell's log says why"; return 1 ;;
      unknown) ASK_RELAY_WHY="The bar cannot be reached"; return 1 ;;
      *) return 0 ;;
    esac
  fi
  ASK_RELAY_WHY="The bar cannot be reached"
  return 1
}

pending_control() {
  jq -e 'type == "object" and (.nodiPending | type == "string" and length > 0)' >/dev/null 2>&1 <<<"$1"
}

# A transport ending while an action waits withdraws only its uncommitted
# request. Ask decides whether it is still cancellable.
ask_relay_cancel_hook() {
  [ "${NODI_ASK_TEST_SIGNAL_CANCEL_STAGE:-}" = "$1" ] || return 0
  [ "$ASK_RELAY_CANCEL_HOOKED" -eq 0 ] || return 0
  ASK_RELAY_CANCEL_HOOKED=1
  [ -z "${NODI_ASK_TEST_CANCEL_MARKER:-}" ] \
    || printf '%s' "$1" > "$NODI_ASK_TEST_CANCEL_MARKER"
  kill -TERM "$$"
}

ask_relay_cancel() {
  local ticket req
  local saved_out=$ASK_RELAY_OUT saved_why=$ASK_RELAY_WHY saved_code=$ASK_RELAY_CODE saved_busy=$ASK_RELAY_BUSY
  ask_relay_cancel_hook before-busy
  ASK_RELAY_BUSY=1
  ask_relay_cancel_hook after-busy
  ticket=$ASK_RELAY_TICKET
  ask_relay_cancel_hook after-capture
  ASK_RELAY_TICKET=""
  ask_relay_cancel_hook after-clear
  if [ -z "$ticket" ]; then
    ASK_RELAY_BUSY=$saved_busy
    return 0
  fi
  if req=$(NODI_T=$NODI_ASK_SESSION NODI_C=$NODI_ASK_CHANNEL NODI_P=$ticket jq -cn \
    '{token: $ENV.NODI_T, channel: $ENV.NODI_C, op: "cancel", ticket: $ENV.NODI_P}' 2>/dev/null); then
    ask_relay_call "$req" || :
  fi
  ask_relay_cancel_hook after-attempt
  ASK_RELAY_OUT=$saved_out
  ASK_RELAY_WHY=$saved_why
  ASK_RELAY_CODE=$saved_code
  ASK_RELAY_BUSY=$saved_busy
}

# A signal while a shell response is being collected or decoded is deferred
# until its pending ticket has been published. Outside that small critical
# section, cancellation can be sent immediately.
ask_relay_signal() {
  ASK_RELAY_STOP=1
  [ "$ASK_RELAY_BUSY" -eq 1 ] && return 0
  ask_relay_cancel
  exit 0
}

ask_relay_reader() {
  local s
  while :; do
    read_line 65537; s=$?
    printf '%s\n' "$s"
    [ "$s" -eq 0 ] && printf '%s\n' "$line"
    [ "$s" -eq 1 ] && return 0
  done
}

# One event from the bounded reader: 0 received, 2 timed out. The event is
# in ASK_RELAY_INPUT_STATUS (0 line, 1 EOF, 3 oversize), and a line is in
# `line`. A persistent reader owns partial input between poll intervals.
ask_relay_next() {
  local timeout=${1-} s status
  if [ -n "$timeout" ]; then
    IFS= read -r -t "$timeout" -u "$ASK_RELAY_READER_FD" status; s=$?
    if [ "$s" -ne 0 ]; then
      [ "$s" -gt 128 ] && return 2
      ASK_RELAY_INPUT_STATUS=1
      return 0
    fi
  else
    if ! IFS= read -r -u "$ASK_RELAY_READER_FD" status; then
      ASK_RELAY_INPUT_STATUS=1
      return 0
    fi
  fi
  ASK_RELAY_INPUT_STATUS=$status
  if [ "$status" -eq 0 ]; then
    if ! IFS= read -r -u "$ASK_RELAY_READER_FD" line; then
      ASK_RELAY_INPUT_STATUS=1
    fi
  fi
  return 0
}

ask_relay_cleanup() {
  if [ -n "$ASK_RELAY_READER_PID" ]; then
    kill "$ASK_RELAY_READER_PID" 2>/dev/null || :
    if [ -n "$ASK_RELAY_READER_WRITE" ]; then
      exec {ASK_RELAY_READER_WRITE}>&-
      ASK_RELAY_READER_WRITE=""
    fi
    wait "$ASK_RELAY_READER_PID" 2>/dev/null || :
    ASK_RELAY_READER_PID=""
  fi
  if [ -n "$ASK_RELAY_READER_FD" ]; then
    exec {ASK_RELAY_READER_FD}<&-
    ASK_RELAY_READER_FD=""
  fi
  [ -z "$carry_dir" ] || rm -rf -- "$carry_dir"
}

# Exact retransmissions share one pending lifecycle. Retaining only their
# count keeps memory fixed; every admitted copy receives the same terminal
# JSON-RPC line as the original request.
ask_relay_reply_all() {
  local response=$1 n=0
  while [ "$n" -le "$ASK_RELAY_DUPLICATES" ]; do
    printf '%s\n' "$response"
    n=$((n + 1))
  done
}

# Process one complete message that arrived while ASK_RELAY_ID is pending.
# A matching cancellation is 1; every other message is handled here and 0.
ask_relay_pending_message() {
  local kind incoming_id incoming_request response
  if [ -n "$ASK_RELAY_ID" ] && jq -e --argjson wanted "$ASK_RELAY_ID" \
    'type == "object" and .method == "notifications/cancelled"
     and (.params | type == "object") and (.params | has("requestId"))
     and ((.params.requestId | type) == ($wanted | type))
     and .params.requestId == $wanted' >/dev/null 2>&1 <<<"$line"; then
    ask_relay_cancel
    [ "$ASK_RELAY_STOP" -eq 0 ] || exit 0
    response=$(mcp_error "$ASK_RELAY_ID" -32800 "Request cancelled")
    ask_relay_reply_all "$response"
    return 1
  fi
  if ! kind=$(jq -r 'if type != "object" then "bad" elif has("id") then "request" else "note" end' \
      <<<"$line" 2>/dev/null); then
    mcp_error null -32700 "parse error"
    return 0
  fi
  if [ "$kind" = bad ]; then
    mcp_error null -32600 "not a request object"
  elif [ "$kind" = request ]; then
    incoming_id=$(jq -cS '.id' <<<"$line")
    incoming_request=$(jq -cS '.' <<<"$line")
    if [ "$incoming_id" = "$ASK_RELAY_ID" ]; then
      if [ "$incoming_request" != "$ASK_RELAY_REQUEST" ]; then
        mcp_error "$incoming_id" -32600 "Request ID is already pending with different content"
      elif [ "$ASK_RELAY_DUPLICATES" -ge "$ASK_RELAY_DUPLICATE_LIMIT" ]; then
        mcp_error "$incoming_id" -32000 "Too many duplicate requests are already waiting"
      else
        ASK_RELAY_DUPLICATES=$((ASK_RELAY_DUPLICATES + 1))
      fi
    else
      mcp_error "$incoming_id" -32000 "Another request is already in progress"
    fi
  fi
  # Notifications, including cancellation of another typed ID, get no reply.
  return 0
}

ask_relay() {
  local call_status line out mid canonical req poll_req response s input_read input_write reader_fd cancelled
  [ -n "${NODI_ASK_SESSION:-}" ] || fail "nodi mcp --ask is Ask's own: it needs NODI_ASK_SESSION"
  [ -n "${NODI_ASK_CHANNEL:-}" ] || fail "nodi mcp --ask is Ask's own: it needs NODI_ASK_CHANNEL"
  # This limits each short shell IPC exchange, not how long the provider
  # may wait for the person to answer an action.
  OMARCHY_SHELL_IPC_TIMEOUT=${OMARCHY_SHELL_IPC_TIMEOUT:-10s}
  export OMARCHY_SHELL_IPC_TIMEOUT
  # The reader alone owns stdin. It keeps an incomplete line between polls,
  # caps it before publishing it, and applies pipe backpressure instead of
  # accumulating an unbounded queue in this process.
  exec 3<&0
  # After publishing EOF the reader waits on its coprocess input until
  # cleanup, keeping its PID owned and safe to signal.
  coproc ASK_RELAY_INPUT { ask_relay_reader <&3; IFS= read -r || :; }
  input_read=${ASK_RELAY_INPUT[0]}
  # Bash closes the coprocess descriptors when it reaps the reader. Keep a
  # duplicate so all already-published events remain readable through EOF.
  exec {reader_fd}<&"$input_read"
  ASK_RELAY_READER_FD=$reader_fd
  ASK_RELAY_READER_PID=$!
  input_write=${ASK_RELAY_INPUT[1]}
  ASK_RELAY_READER_WRITE=$input_write
  exec 3<&-
  trap 'ask_relay_signal' TERM INT HUP
  carry_init
  trap 'ask_relay_cleanup' EXIT
  # A line past 64 KB could never go to the shell (below): it is read to
  # its end and refused, never held whole.
  while :; do
    ask_relay_next; s=$?
    [ "$s" -eq 0 ] || continue
    [ "$ASK_RELAY_INPUT_STATUS" -eq 1 ] && break
    [ "$ASK_RELAY_INPUT_STATUS" -eq 3 ] && { mcp_error null -32602 "Too long: a message is 64 KB at most"; continue; }
    [ -n "${line//[[:space:]]/}" ] || continue
    mid=$(jq -cS 'if type == "object" and has("id") and has("method") then .id else empty end' <<<"$line" 2>/dev/null)
    canonical=$(jq -cS '.' <<<"$line" 2>/dev/null) || canonical=""
    # The shell's facade takes one argument (shell.qml call(id, method,
    # arg); Fable 2026-10-07: two were refused, every message with them):
    # the token and the line as one JSON object, carried in a file (carry);
    # past 64 KB it is refused here.
    # In jq's environment, not its arguments: the message, and the token
    # that is the tool server's word to Ask (the marketplace's review, 2026-10-10).
    req=$(NODI_T=$NODI_ASK_SESSION NODI_C=$NODI_ASK_CHANNEL NODI_L=$line jq -cn \
      '{token: $ENV.NODI_T, channel: $ENV.NODI_C, op: "call", line: $ENV.NODI_L}' 2>/dev/null) || req=""
    ASK_RELAY_BUSY=1
    ask_relay_call "$req"; call_status=$?
    out=$ASK_RELAY_OUT
    if [ "$call_status" -eq 0 ] && pending_control "$out"; then
      ASK_RELAY_TICKET=$(jq -r '.nodiPending' <<<"$out")
      ASK_RELAY_ID=$mid
      ASK_RELAY_REQUEST=$canonical
      ASK_RELAY_DUPLICATES=0
    fi
    ASK_RELAY_BUSY=0
    if [ "$ASK_RELAY_STOP" -eq 1 ]; then ask_relay_cancel; exit 0; fi
    if [ "$call_status" -ne 0 ]; then
      [ -n "$mid" ] && mcp_error "$mid" "$ASK_RELAY_CODE" "$ASK_RELAY_WHY"
      continue
    fi
    cancelled=0
    while pending_control "$out"; do
      # Four checks a second keep Enter responsive without spawning an IPC
      # client and several parsers twenty times a second while a card waits.
      ask_relay_next 0.25; s=$?
      if [ "$s" -eq 0 ]; then
        if [ "$ASK_RELAY_INPUT_STATUS" -eq 1 ]; then
          ask_relay_cancel
          exit 0
        elif [ "$ASK_RELAY_INPUT_STATUS" -eq 3 ]; then
          mcp_error null -32602 "Too long: a message is 64 KB at most"
        elif [ -n "${line//[[:space:]]/}" ]; then
          if ask_relay_pending_message; then :; else
            cancelled=1
            break
          fi
        fi
      fi
      poll_req=$(NODI_T=$NODI_ASK_SESSION NODI_C=$NODI_ASK_CHANNEL NODI_P=$ASK_RELAY_TICKET jq -cn \
        '{token: $ENV.NODI_T, channel: $ENV.NODI_C, op: "poll", ticket: $ENV.NODI_P}' 2>/dev/null) || poll_req=""
      ASK_RELAY_BUSY=1
      ask_relay_call "$poll_req"; call_status=$?
      out=$ASK_RELAY_OUT
      if [ "$call_status" -eq 0 ] && pending_control "$out"; then
        ASK_RELAY_TICKET=$(jq -r '.nodiPending' <<<"$out")
      fi
      ASK_RELAY_BUSY=0
      if [ "$ASK_RELAY_STOP" -eq 1 ]; then ask_relay_cancel; exit 0; fi
      if [ "$call_status" -ne 0 ]; then
        ask_relay_cancel
        [ "$ASK_RELAY_STOP" -eq 0 ] || exit 0
        break
      fi
    done
    ASK_RELAY_TICKET=""
    ASK_RELAY_ID=""
    ASK_RELAY_REQUEST=""
    if [ "$cancelled" -ne 0 ]; then
      ASK_RELAY_DUPLICATES=0
      continue
    fi
    if [ "$call_status" -eq 0 ] && [ -n "$out" ] && ! pending_control "$out"; then
      ask_relay_reply_all "$out"
      ASK_RELAY_DUPLICATES=0
      continue
    fi
    # Only a notification goes unanswered.
    if [ -n "$mid" ]; then
      response=$(mcp_error "$mid" "$ASK_RELAY_CODE" "$ASK_RELAY_WHY")
      ask_relay_reply_all "$response"
    fi
    ASK_RELAY_DUPLICATES=0
  done
}

case ${1-} in
  "") out=$(ask summon "$id" '{}') || exit $?; [ "$out" = ok ] || fail "Nodi did not open ($out)" ;;
  -h|--help) usage ;;
  --) shift; open_with "$*" ;;
  run)
    [ $# -eq 2 ] || fail "usage: nodi run <key>"
    out=$(ask call "$id" runRow "$2") || exit $?
    [ "$out" = ok ] || fail "$2: $out"
    ;;
  pick) shift; pick "$@" ;;
  mcp)
    if [ $# -eq 2 ] && [ "$2" = --ask ]; then ask_relay
    else [ $# -eq 1 ] || fail "usage: nodi mcp"; mcp; fi ;;
  *) open_with "$*" ;;
esac
