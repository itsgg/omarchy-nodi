#!/bin/bash
# Nodi's `wikipedia` answer (contrib/README.md): `wp <words>`, then Enter:
# the Wikipedia article they find, its summary as Markdown in the pane, with
# a link to the whole of it. English unless an argument names another
# Wikipedia ("args": ["ta"] for Tamil). Asks <lang>.wikipedia.org twice,
# its search and its summary of the first article found. The words are
# NODI_QUERY, and they and the article they find reach no program's
# arguments, which any local user can read in /proc: curl takes both by
# --variable (the marketplace's review, 2026-10-10).
set -u
q=${NODI_QUERY-}
lang=${1-en}
case $lang in *[!a-z-]*|"") printf 'No Wikipedia is named `%s`: an argument is a language code, such as `en` or `ta`.\n' "$lang"; exit 0 ;; esac
base="https://$lang.wikipedia.org"
# Each answer at most 2 MB, over https only; -q first, so no ~/.curlrc
# turns on a redirect.
agent="Nodi (https://github.com/itsgg/omarchy-nodi)"
words=$(printf '%s' "$q" | jq -sRr @uri)
found=$(NODI_WORDS=$words curl -q -fsS --max-time 10 --max-filesize 2097152 --proto =https -A "$agent" \
          --variable %NODI_WORDS --expand-url "$base/w/api.php?action=query&list=search&srlimit=1&format=json&srsearch={{NODI_WORDS}}") \
  || { printf 'Wikipedia did not answer.\n' >&2; exit 1; }
title=$(printf '%s' "$found" | jq -r '.query.search[0].title // empty')
[ -n "$title" ] || { printf 'Wikipedia has no article for *%s*.\n' "$q"; exit 0; }
page=$(printf '%s' "$title" | jq -sRr 'gsub(" "; "_") | @uri')
# Kept first, so a failed request says so: piped, only jq's status was seen,
# and an empty answer showed with no reason (Fable 2026-10-07).
summary=$(NODI_PAGE=$page curl -q -fsS --max-time 10 --max-filesize 2097152 --proto =https -A "$agent" \
            --variable %NODI_PAGE --expand-url "$base/api/rest_v1/page/summary/{{NODI_PAGE}}") \
  || { printf 'Wikipedia did not answer.\n' >&2; exit 1; }
printf '%s' "$summary" \
  | jq -r '"# " + .title + "\n\n" + (if .description then "*" + .description + "*\n\n" else "" end)
           + (.extract // "") + "\n\n[Read the article](" + (.content_urls.desktop.page // "") + ")"' \
  || { printf 'Wikipedia did not answer.\n' >&2; exit 1; }
