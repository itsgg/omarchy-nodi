#!/bin/bash
# Nodi's `weather` answer (contrib/README.md): `weather chennai`, then
# Enter: the weather there now and the next three days, as Markdown in the
# pane, in Celsius unless an argument says "us" (Fahrenheit). Asks wttr.in
# once; "here" asks for where your connection appears to be.
set -u
q=${!#}
unit=C
[ $# -ge 2 ] && [ "$1" = us ] && unit=F
place=$q
case $(printf '%s' "$place" | tr '[:upper:]' '[:lower:]') in here|"") place="" ;; esac
where=$(printf '%s' "$place" | jq -sRr 'gsub(" "; "+") | @uri | gsub("%2B"; "+")')
# wttr.in answers a place it does not know with an error status, which is
# said as that, not as wttr.in being down (Fable 2026-10-07).
body=$(mktemp) || exit 1
trap 'rm -f -- "$body"' EXIT
# At most 1 MB, over https only: a body past it fails the request; -q
# first, so no ~/.curlrc turns on a redirect.
code=$(curl -q -sS --max-time 10 --max-filesize 1048576 --proto =https -A "curl (Nodi)" -o "$body" -w '%{http_code}' "https://wttr.in/$where?format=j1") || { printf 'wttr.in did not answer.\n' >&2; exit 1; }
case $code in
  200) got=$(cat -- "$body") ;;
  404|500) printf 'wttr.in knows no place called *%s*.\n' "$q"; exit 0 ;;
  *) printf 'wttr.in did not answer (%s).\n' "$code" >&2; exit 1 ;;
esac
printf '%s' "$got" | jq -r --arg u "$unit" --arg asked "$q" '
  def t(c; f): if $u == "F" then f + "°F" else c + "°C" end;
  def sky: (.weatherDesc[0].value // "") | gsub("^\\s+|\\s+$"; "");
  (.nearest_area[0] // {}) as $a
  | (($a.areaName[0].value // "") + (if $a.country[0].value then ", " + $a.country[0].value else "" end)) as $station
  | .current_condition[0] as $c
  | ($asked | test("^\\s*(here)?\\s*$"; "i")) as $here
  | "# " + (if $here then $station else $asked end) + "\n\n"
    + (if $station != "" and ($here | not) then "*Measured near " + $station + "*\n\n" else "" end)
    + "**" + t($c.temp_C; $c.temp_F) + "**, " + ($c | sky) + ", feels like " + t($c.FeelsLikeC; $c.FeelsLikeF)
    + "\n\nHumidity " + $c.humidity + "%, wind " + (if $u == "F" then $c.windspeedMiles + " mph" else $c.windspeedKmph + " km/h" end)
    + ", rain " + $c.precipMM + " mm\n\n"
    + "| Day | Low | High | Sky |\n|---|---|---|---|\n"
    + ([.weather[] | "| " + .date + " | " + t(.mintempC; .mintempF) + " | " + t(.maxtempC; .maxtempF) + " | "
        + (.hourly[4] | sky) + " |"] | join("\n"))' \
  || { printf 'wttr.in gave no weather for that.\n' >&2; exit 1; }
